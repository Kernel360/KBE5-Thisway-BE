{
  "uid": "thisway-reliability",
  "title": "Thisway — ingestion, storage and recovery",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"spring-boot-application\"}[1m]))",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 / seconds",
      "description": "Histogram estimate; HTTP completion does not imply GPS database commit.",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring-boot-application\"}[1m])))",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 5xx fraction",
      "description": "No traffic yields no data, not zero errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"spring-boot-application\",status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"spring-boot-application\"}[1m]))",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Telemetry admission rejections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"spring-boot-application\",uri=~\"/api/logs/.*\",status=~\"409|429|503\"}[1m]))",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPS broker confirmed / second",
      "description": "Broker acceptance, not database storage.",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gps_publisher_storage_confirmed_total[1m]))",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GPS transaction completions / second",
      "description": "Committed handler invocations include duplicates; not unique GPS row count or broker ack.",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(gps_consumer_processing_seconds_count[1m]))",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPS transaction p95 / seconds",
      "description": "Consumer entry to service transaction return; excludes queue wait.",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gps_consumer_processing_seconds_bucket{outcome=\"committed\"}[1m])))",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Publisher queued tasks",
      "description": "Bounded capacity 64; active workers maximum 4.",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gps_publisher_queued",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RabbitMQ ready messages — 1m peak",
      "description": "Per-exported-series maximum over the last minute, not instantaneous backlog. Keeps short scraped spikes visible at dashboard query resolution.",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time(rabbitmq_queue_messages_ready[1m])",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "RabbitMQ unacknowledged messages",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rabbitmq_queue_messages_unacked)",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "JVM heap used",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Process CPU",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "JVM GC pause / second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jvm_gc_pause_seconds_sum[1m]))",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "DB pool active connections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "DB pool pending connections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Scrape health",
      "description": "0 means scrape failed; missing target inventory is separate from failed scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Statistics correction outcomes",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(thisway_statistics_correction_total[5m]))",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Address recovery outcomes",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "thisway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(thisway_trip_address_worker_total[5m]))",
          "legendFormat": "{{outcome}}{{status}}{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
